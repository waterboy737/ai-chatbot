# Copy this file to .env and fill in the keys you plan to use

# LLM / Embeddings providers (choose any; code supports multiple providers)
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
COHERE_API_KEY=
TOGETHERAI_API_KEY=
REPLICATE_API_TOKEN=
VOYAGE_API_KEY=

# Provider selection (comma-separated fallback order). Examples:
# LLM_PROVIDERS=huggingface,openai,together,replicate
# EMBEDDINGS_PROVIDERS=huggingface,cohere,openai,voyage
LLM_PROVIDERS=huggingface,openai,together,replicate
EMBEDDINGS_PROVIDERS=huggingface,cohere,openai,voyage

# Flask / Database
FLASK_SECRET_KEY=change-me
DATABASE_URL=sqlite:///data/app.db

# GitHub OAuth (placeholders)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Slack / Discord tokens (optional)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DISCORD_BOT_TOKEN=

# Vector store / FAISS
FAISS_INDEX_PATH=./data/faiss.index

# Railway deployment: set these in Railway project settings

